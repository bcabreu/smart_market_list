rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function activePaidOwner(userId) {
      let owner = userDoc(userId).data;
      return owner.purchasePremium == true
        && (owner.purchaseExpiresAt == null
          || owner.purchaseExpiresAt > request.time);
    }

    function activeFamilyOwner(familyId) {
      let family = familyDoc(familyId).data;
      let owner = userDoc(family.ownerId).data;
      return owner.purchasePremium == true
        && owner.purchasePlanType == 'premium_family'
        && (owner.purchaseExpiresAt == null
          || owner.purchaseExpiresAt > request.time);
    }

    function fullWorkspaceAccess(familyId) {
      let family = familyDoc(familyId).data;
      let user = userDoc(request.auth.uid).data;
      return signedIn()
        && user.familyId == familyId
        && (
          (family.ownerId == request.auth.uid
            && activePaidOwner(request.auth.uid))
          || (family.guestId == request.auth.uid
            && activeFamilyOwner(familyId))
        );
    }

    function effectivePremium(userId) {
      let user = userDoc(userId).data;
      return activePaidOwner(userId)
        || (user.role == 'guest'
          && user.familyId != null
          && familyDoc(user.familyId).data.guestId == userId
          && activeFamilyOwner(user.familyId));
    }

    function sameActiveFamily(targetData) {
      let caller = userDoc(request.auth.uid).data;
      return signedIn()
        && caller.familyId != null
        && caller.familyId == targetData.familyId
        && fullWorkspaceAccess(caller.familyId);
    }

    function validProfileCreate() {
      return request.resource.data.keys().hasOnly([
        'email', 'name', 'photoUrl', 'lastLogin'
      ])
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 320
      && (!request.resource.data.keys().hasAny(['name'])
        || request.resource.data.name is string)
      && (!request.resource.data.keys().hasAny(['photoUrl'])
        || request.resource.data.photoUrl is string);
    }

    function validProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'email', 'name', 'photoUrl', 'lastLogin'
      ])
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 320
      && (!request.resource.data.keys().hasAny(['name'])
        || request.resource.data.name is string)
      && (!request.resource.data.keys().hasAny(['photoUrl'])
        || request.resource.data.photoUrl is string);
    }

    function listAccess(data, familyId) {
      return fullWorkspaceAccess(familyId)
        || (signedIn()
          && request.auth.uid in data.members
          && (
            (data.keys().hasAny(['shareSponsorId'])
              && data.shareSponsorId is string
              && activePaidOwner(data.shareSponsorId))
            || (!data.keys().hasAny(['shareSponsorId'])
              && data.ownerId is string
              && activePaidOwner(data.ownerId))
          ));
    }

    function validListContent() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 16
        && request.resource.data.budget is number
        && request.resource.data.budget >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || (signedIn() && sameActiveFamily(resource.data));
      allow create: if isSelf(userId) && validProfileCreate();
      allow update: if isSelf(userId) && validProfileUpdate();
      allow delete: if false;

      match /custom_items/{itemId} {
        allow read, create, update, delete:
          if isSelf(userId) && effectivePremium(userId);
      }

      match /custom_categories/{categoryId} {
        allow read, create, update, delete:
          if isSelf(userId) && effectivePremium(userId);
      }

      match /shared_lists/{membershipId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if false;
      }
    }

    // Invite contents include token hashes and are server-only.
    match /family_invites/{inviteId} {
      allow read, write: if false;
    }

    match /list_invites/{inviteId} {
      allow read, write: if false;
    }

    // Server-only grants cover explicit administrative or lifetime access.
    // The backend materializes their result on /users; clients never inspect
    // or modify the grant itself.
    match /subscription_grants/{userId} {
      allow read, write: if false;
    }

    // Blocks the insecure legacy collection as well.
    match /invitations/{inviteId} {
      allow read, write: if false;
    }

    match /families/{familyId} {
      allow read: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (resource.data.guestId == request.auth.uid
            && activeFamilyOwner(familyId))
        );
      allow create, update, delete: if false;

      match /shopping_lists/{listId} {
        allow read: if listAccess(resource.data, familyId);
        allow create: if fullWorkspaceAccess(familyId)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.familyId == familyId
          && request.auth.uid in request.resource.data.members
          && validListContent();
        allow update: if listAccess(resource.data, familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'emoji', 'budget', 'items'
          ])
          && validListContent();
        allow delete: if fullWorkspaceAccess(familyId)
          || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && activePaidOwner(request.auth.uid));
      }

      match /shopping_notes/{noteId} {
        allow read, create, update, delete:
          if fullWorkspaceAccess(familyId);
      }

      match /favorite_recipes/{recipeId} {
        allow read, create, update, delete:
          if fullWorkspaceAccess(familyId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
